# GenLab — env vars
# Copy this file to `.env` and adjust values.

# SQLite database location. Use absolute path. The bundled db/custom.db
# already contains sessions/genes/inventions from prior runs — keep it
# unless you want a fresh start.
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ZAI SDK picks up its API key from the environment automatically.
# On Z.ai infrastructure the key is injected — no action needed.
# For local runs outside Z.ai, set ZAI_API_KEY explicitly:
# ZAI_API_KEY=...
